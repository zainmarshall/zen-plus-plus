// BFS traversal of an undirected graph

n, m = read(), read()
adj = graph(n, m)

visited = fill(n, 0)
visited[0] = 1

q = Queue()
q.init()
q.push(0)

while q.size() > 0 {
    node = q.pop()
    println(node)
    for neighbor in adj[node] {
        if visited[neighbor] == 0 {
            visited[neighbor] = 1
            q.push(neighbor)
        }
    }
}
