// Codeforces 2200A - Eating Game
// Simulate circular eating for each starting player, count distinct winners
import std

fn solve() {
    n = read()
    a = read(n)

    winners = set()
    for s n {
        b = a[0:n]

        total = 0
        for x in b { total += x }

        last = 0
        cur = s
        while total > 0 {
            if b[cur] > 0 {
                b[cur] = b[cur] - 1
                total = total - 1
                last = cur
            }
            cur = (cur + 1) % n
        }
        winners.add(last)
    }
    println(winners.size())
}

t = read()
while t-- { solve() }
