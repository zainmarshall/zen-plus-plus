// Codeforces 1084B - Deletion Sort
// If already sorted, answer is n; otherwise 1

fn solve() {
    n = read()
    a = read(n)

    is_sorted = 1
    for i 1 n {
        if a[i] < a[i - 1] {
            is_sorted = 0
            break
        }
    }
    if is_sorted { println(n) } else { println(1) }
}

t = read()
while t-- { solve() }
