// Codeforces 1084D - Portal
// Split array, rotate inner segment so min is first, merge back

fn solve() {
    n = read()
    x = read()
    y = read()
    x--
    y--

    vals = read(n)
    a = []
    b = []
    for i n {
        if i <= x || i > y {
            push(a, vals[i])
        } else {
            push(b, vals[i])
        }
    }

    if len(b) > 0 {
        // find index of minimum in b
        mi = 0
        for i 1 len(b) {
            if b[i] < b[mi] { mi = i }
        }
        // rotate so min is first
        b = b[mi:len(b)] + b[0:mi]
    }

    m = -1
    if len(b) > 0 { m = b[0] }

    // find insertion point in a
    pos = len(a)
    for i len(a) {
        if a[i] >= m {
            pos = i
            break
        }
    }

    // build result: a[:pos] + b + a[pos:]
    res = a[0:pos] + b + a[pos:len(a)]
    for i len(res) {
        if i > 0 { print(" ") }
        print(res[i])
    }
    println("")
}

t = read()
while t-- { solve() }
