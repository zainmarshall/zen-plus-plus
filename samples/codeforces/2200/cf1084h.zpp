// Codeforces 2200H - Six Seven
// Recursive mod-42 grouping
// Uses global save_stack to work around Zen++ having no function-local scope

INF = 4000000000000000000
save_stack = []

fn sort_vec(v) {
    sort(v)
}

fn f(a) {
    if len(a) == 0 { return 0 }
    if a[len(a) - 1] == 1 { return 5 }

    fmod6 = a[0] % 6
    fg0 = []
    fg1 = []
    fg2 = []
    fg3 = []
    fg4 = []
    fg5 = []
    fg6 = []

    for xx in a {
        if xx % 6 != fmod6 { return INF }
        rr = (xx - fmod6) / 6 % 7
        if rr == 0 { push(fg0, xx) }
        else if rr == 1 { push(fg1, xx) }
        else if rr == 2 { push(fg2, xx) }
        else if rr == 3 { push(fg3, xx) }
        else if rr == 4 { push(fg4, xx) }
        else if rr == 5 { push(fg5, xx) }
        else { push(fg6, xx) }
    }

    fgroups = [fg0, fg1, fg2, fg3, fg4, fg5, fg6]

    // precompute all next arrays and k values before recursing
    fall_next = []
    fall_k = []
    for r 7 {
        fk = (42 - 6 * r - fmod6) % 42
        push(fall_k, fk)
        fgr = fgroups[r]
        fnxt = []
        for yy in fgr {
            push(fnxt, (yy + fk) / 42)
        }
        push(fall_next, fnxt)
    }

    fans = INF
    for r 7 {
        // save state before recursive call
        push(save_stack, fall_next)
        push(save_stack, fall_k)
        push(save_stack, fans)

        fnxt = fall_next[r]
        rec = f(fnxt)

        // restore state after recursive call
        fans = pop(save_stack)
        fall_k = pop(save_stack)
        fall_next = pop(save_stack)

        if rec < INF {
            fval = fall_k[r] + 42 * rec
            if fval < fans { fans = fval }
        }
    }
    return fans
}

fn solve() {
    n = read()
    a = read(n)
    sort_vec(a)
    res = f(a)
    if res >= INF { println(-1) } else { println(res) }
}

t = read()
while t-- { solve() }
