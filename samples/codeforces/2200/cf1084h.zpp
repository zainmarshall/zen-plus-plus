// Codeforces 2200H - Six Seven
// Recursive mod-42 grouping
import std

INF = 4000000000000000000

fn sort_vec(v) {
    for i 1 len(v) {
        j = i
        while j > 0 && v[j] < v[j - 1] {
            tmp = v[j]
            v[j] = v[j - 1]
            v[j - 1] = tmp
            j--
        }
    }
}

fn f(a) {
    if len(a) == 0 { return 0 }
    if a[len(a) - 1] == 1 { return 5 }

    mod6 = a[0] % 6
    g0 = []
    g1 = []
    g2 = []
    g3 = []
    g4 = []
    g5 = []
    g6 = []

    for x in a {
        if x % 6 != mod6 { return INF }
        r = (x - mod6) / 6 % 7
        if r == 0 { push(g0, x) }
        else if r == 1 { push(g1, x) }
        else if r == 2 { push(g2, x) }
        else if r == 3 { push(g3, x) }
        else if r == 4 { push(g4, x) }
        else if r == 5 { push(g5, x) }
        else { push(g6, x) }
    }

    groups = [g0, g1, g2, g3, g4, g5, g6]

    ans = INF
    for r 7 {
        k = (42 - 6 * r - mod6) % 42
        gr = groups[r]
        next = []
        for x in gr {
            push(next, (x + k) / 42)
        }
        rec = f(next)
        if rec < INF {
            val = k + 42 * rec
            if val < ans { ans = val }
        }
    }
    return ans
}

fn solve() {
    n = read()
    a = []
    for i n { push(a, read()) }
    sort_vec(a)
    res = f(a)
    if res >= INF { println(-1) } else { println(res) }
}

t = read()
while t-- { solve() }
