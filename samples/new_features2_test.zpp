// === 1. Bitwise NOT ===
println("--- Bitwise NOT ---")
println(~0)          // -1
println(~1)          // -2
println(~(-1))       // 0
x = 13               // 1101
println(~x & 15)     // 0010 = 2 (mask to 4 bits)

// clearBit using ~
fn clearBit(n, i) {
    return n & ~(1 << i)
}
println(clearBit(15, 2))  // 1111 -> 1011 = 11

// === 2. min/max on vectors ===
println("--- min/max ---")
v = [3, 1, 4, 1, 5, 9, 2, 6]
println(min(v))       // 1
println(max(v))       // 9

// still works with 2 args
println(min(3, 7))    // 3
println(max(3, 7))    // 7

// works with strings
println(min("apple", "banana"))  // apple
println(max(["z", "a", "m"]))   // z

// === 3. String interpolation ===
println("--- f-strings ---")
name = "world"
println(f"hello {name}")          // hello world
x = 42
println(f"x = {x}")              // x = 42
println(f"{1 + 2} + {3 + 4} = {1+2+3+4}")  // 3 + 7 = 10
v = [1, 2, 3]
println(f"vector: {v}")          // vector: [1, 2, 3]
println(f"len={len(v)}")         // len=3

// nested expressions
a = 10
b = 3
println(f"{a} / {b} = {a / b} remainder {a % b}")

// === 4. all/any ===
println("--- all/any ---")
v = [2, 4, 6, 8]
println(all(v, fn(x) { x % 2 == 0 }))  // 1 (all even)
println(any(v, fn(x) { x > 7 }))        // 1 (8 > 7)
println(all(v, fn(x) { x > 5 }))        // 0 (2 is not > 5)

v2 = [1, 3, 5, 7]
println(any(v2, fn(x) { x % 2 == 0 }))  // 0 (none even)

// empty vector
println(all([], fn(x) { x > 0 }))   // 1 (vacuously true)
println(any([], fn(x) { x > 0 }))   // 0

// === 5. Chained comparisons ===
println("--- Chained comparisons ---")
x = 5
println(1 < x < 10)       // 1
println(1 < x < 3)        // 0
println(0 <= x <= 5)      // 1
println(1 <= 2 <= 3)      // 1
println(1 < 2 < 3 < 4)   // 1
println(1 < 2 < 3 < 2)   // 0

// === 6. Destructuring ===
println("--- Destructuring ---")
[a, b, c] = [10, 20, 30]
println(a)    // 10
println(b)    // 20
println(c)    // 30

// with discard
[x, _, z] = [100, 200, 300]
println(x)    // 100
println(z)    // 300

// from function return
fn getPoint() {
    return [3, 4]
}
[px, py] = getPoint()
println(f"point: ({px}, {py})")  // point: (3, 4)

// from read vector
v = [1, 2, 3, 4, 5]
[first, second, _] = v
println(f"first={first}, second={second}")  // first=1, second=2

println("--- All tests passed! ---")
