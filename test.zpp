// arithmetic
x = 8
y = 3
println(x + y)
println(x - y)
println(x * y)
println(x / y)
println(x % y)
println(5!)

// booleans and conditionals
println(x > y)
println(x == y)

if x > y {
  println(100)
} else if x == y {
  println(200)
} else {
  println(300)
}

// while + ++
i = 0
while i < 3 {
  println(i)
  i++
}

// for loops
for j 5 {
  println(j)
}

// functions
fn add(a, b) {
  return a + b
}
println(add(10, 20))

// strings
s = "zen"
t = "++"
u = s + t
println(s)
println(t)
println(u)
println(len(u))
println(u[1])

// vectors basics
v = [1, 2, 3]
println(v)
println(len(v))
println(v[0])
println(v[2])

push(v, 10)
push(v, 11)
println(v)
println(len(v))
println(pop(v))
println(v)

// vector concat
w = [100, 200]
z = v + w
println(z)
println(len(z))

// vector index assignment
v[1] = 99
println(v)
v[0] = v[1] + 1
println(v)

// multidimensional array + nested index assignment
m = [[1, 2], [3, 4], [5, 6]]
println(m)
println(m[1][0])
m[1][0] = 77
println(m)
m[2][1] = m[1][0] + 5
println(m)
