/* zen++ comprehensive feature test */

// arithmetic + assignment
x = 7
y = 3
print(x + y)
print(x - y)
print(x * y)
print(x / y)
print(x % y)
print(x ^ y)
print(5!)

// booleans + comparisons
print(x == y)
print(x != y)
print(x > y)
print(x < y)
print(x >= y)
print(x <= y)

// if / else-if / else
if x < y {
    print(111)
} else if x == y {
    print(222)
} else {
    print(333)
}

// while loop + ++
i = 0
while i < 4 {
    print(i)
    i++
}

// for loop short form
for j 5 {
    print(j)
}

// functions + return
fn square(n) {
    return n * n
}
print(square(9))

fn mix(a, b) {
    return a + b
}
print(mix(12, 30))

// strings
s = "zen"
t = "++"
print(s)
print(t)
print(s + t)
print(len(s + t))
print((s + t)[1])

// vectors
v = [1, 2, 3]
print(v)
print(len(v))
print(v[0])
print(v[2])

push(v, 10)
push(v, 20)
print(v)
print(len(v))

p = pop(v)
print(p)
print(v)

w = [100, 200]
z = v + w
print(z)
print(len(z))

nested = [v, w, [7, 8]]
print(nested)
print(nested[2][1])
