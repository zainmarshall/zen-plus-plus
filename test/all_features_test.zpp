/* zen++ comprehensive feature test */

// arithmetic + assignment
x = 7
y = 3
println(x + y)
println(x - y)
println(x * y)
println(x / y)
println(x % y)
println(x ** y)
println(5!)
println(x ^ y)
println(x & y)
println(x | y)

// booleans + comparisons
println(x == y)
println(x != y)
println(x > y)
println(x < y)
println(x >= y)
println(x <= y)

// if / else-if / else
if x < y {
    println(111)
} else if x == y {
    println(222)
} else {
    println(333)
}

// while loop + ++
i = 0
while i < 4 {
    println(i)
    i++
}

// for loop short form
for j 5 {
    println(j)
}

// functions + return
fn square(n) {
    return n * n
}
println(square(9))

fn mix(a, b) {
    return a + b
}
println(mix(12, 30))

// strings
s = "zen"
t = "++"
println(s)
println(t)
println(s + t)
println(len(s + t))
println((s + t)[1])

// vectors
v = [1, 2, 3]
println(v)
println(len(v))
println(v[0])
println(v[2])

push(v, 10)
push(v, 20)
println(v)
println(len(v))

p = pop(v)
println(p)
println(v)

w = [100, 200]
z = v + w
println(z)
println(len(z))

nested = [v, w, [7, 8]]
println(nested)
println(nested[2][1])

// stdlib data structures
import std

map m
m.set("a", 5)
m.set("b", 9)
println(m.get("a", 0))
println(m.has("c"))

set s
s.add(10)
println(s.has(10))

d = DSU()
d.init(5)
d.unite(1, 2)
println(d.same(1, 2))

pq = PriorityQueue()
pq.init()
pq.push(5)
pq.push(2)
pq.push(9)
println(pq.top())

p = Pair()
p.init(7, 11)
println(p.first)
println(p.second)

t = Tuple()
t.init([1, 2, 3])
println(t.get(2))
