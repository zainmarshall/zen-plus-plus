// Composite benchmark — exercises all hot paths

// 1. Simple loop
x = 0
for i 1000000 { x += 1 }

// 2. Function calls
fn add(a, b) { return a + b }
y = 0
for i 100000 { y = add(y, 1) }

// 3. Variable read/write
a = 0
b = 0
c = 0
for i 500000 {
    a = i
    b = a + 1
    c = b + 1
}

// 4. Recursive function calls (fib(25) = ~240K calls)
fn fib(n) {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}
f = fib(25)

println(x, y, c, f)
