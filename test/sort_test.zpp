// === sort() basic ===
v = [5, 3, 1, 4, 2]
sort(v)
println(v)
// expect: [1, 2, 3, 4, 5]

// === sortdec() basic ===
v2 = [5, 3, 1, 4, 2]
sortdec(v2)
println(v2)
// expect: [5, 4, 3, 2, 1]

// === sort strings ===
s = ["banana", "apple", "cherry"]
sort(s)
println(s)
// expect: [apple, banana, cherry]

// === sort floats ===
f = [3.14, 1.41, 2.72]
sort(f)
println(f)
// expect: [1.41, 2.72, 3.14]

// === sort vectors (lexicographic) ===
pairs = [[3, 1], [1, 3], [2, 2]]
sort(pairs)
println(pairs)
// expect: [[1, 3], [2, 2], [3, 1]]

// === sort with custom comparator ===
// sort by second element ascending
fn bySec(a, b) {
    return a[1] - b[1]
}
pairs2 = [[3, 1], [1, 3], [2, 2]]
sort(pairs2, bySec)
println(pairs2)
// expect: [[3, 1], [2, 2], [1, 3]]

// === sort by second element, then first ===
fn bySecThenFirst(a, b) {
    if a[1] != b[1] { return a[1] - b[1] }
    return a[0] - b[0]
}
pairs3 = [[2, 1], [1, 1], [3, 2]]
sort(pairs3, bySecThenFirst)
println(pairs3)
// expect: [[1, 1], [2, 1], [3, 2]]

// === reverse ===
r = [1, 2, 3, 4, 5]
reverse(r)
println(r)
// expect: [5, 4, 3, 2, 1]

// === reverse strings ===
rs = ["a", "b", "c"]
reverse(rs)
println(rs)
// expect: [c, b, a]

// === sort with inline lambda ===
nums = [5, 3, 1, 4, 2]
sort(nums, fn(a, b) { a - b })
println(nums)
// expect: [1, 2, 3, 4, 5]

// === sortdec with lambda ===
nums2 = [5, 3, 1, 4, 2]
sort(nums2, fn(a, b) { b - a })
println(nums2)
// expect: [5, 4, 3, 2, 1]

// === lambda sort by second element ===
items = [[1, 30], [2, 10], [3, 20]]
sort(items, fn(a, b) { a[1] - b[1] })
println(items)
// expect: [[2, 10], [3, 20], [1, 30]]

// === lambda sort by string length ===
words = ["banana", "fig", "apple", "kiwi"]
sort(words, fn(a, b) { len(a) - len(b) })
println(words)
// expect: [fig, kiwi, apple, banana]

// === lambda sort by absolute value ===
vals = [-5, 3, -1, 4, -2]
sort(vals, fn(a, b) {
    aa = a
    bb = b
    if aa < 0 { aa = -aa }
    if bb < 0 { bb = -bb }
    return aa - bb
})
println(vals)
// expect: [-1, -2, 3, 4, -5]

// === edge cases ===
empty = []
sort(empty)
println(empty)
// expect: []

single = [42]
sort(single)
println(single)
// expect: [42]

two = [2, 1]
sort(two)
println(two)
// expect: [1, 2]

println("all sort tests passed")
