{
  "scopeName": "source.zenpp",
  "name": "Zen++",
  "fileTypes": ["zpp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#fstrings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#stdlib" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.zenpp", "match": "//.*$" },
        { "name": "comment.block.zenpp", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.zenpp",
          "begin": "f\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "string.quoted.double.zenpp" } },
          "endCaptures": { "0": { "name": "string.quoted.double.zenpp" } },
          "patterns": [
            {
              "name": "meta.interpolation.zenpp",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.zenpp" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.zenpp" } },
              "patterns": [
                { "include": "source.zenpp" }
              ]
            },
            { "name": "constant.character.escape.zenpp", "match": "\\\\[ntr\\\\\"']" },
            { "name": "string.quoted.double.zenpp", "match": "[^{\"\\\\]+" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zenpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.zenpp", "match": "\\\\[ntr\\\\\"']" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.zenpp", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.zenpp", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.zenpp", "match": "\\b(if|else|while|for|return|import|break|continue|in)\\b" },
        { "name": "keyword.other.zenpp", "match": "\\b(fn|struct)\\b" },
        { "name": "constant.language.zenpp", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.zenpp", "match": "\\b(self)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.zenpp", "match": "\\b(print|println|read|readInt|readFloat|readLine|len|push|pop|ord|chr|parseInt|str|int|float|sort|sortdec|sorted|reverse|unique|flatten|zip|split|join|find|count|swap|fill|replace|upper|lower|trim|contains|startswith|endswith|substr|all|any|min|max|abs|gcd|rand|randvec|exit|graph|dgraph|wgraph|dwgraph|map|set)(?=\\s*\\()" }
      ]
    },
    "stdlib": {
      "patterns": [
        { "name": "support.class.zenpp", "match": "\\b(Stack|Queue|DSU|PriorityQueue|MinPriorityQueue|FenwickTree|SegTree|Pair|Tuple|Map|Set)(?=\\s*\\()" },
        { "name": "support.function.zenpp", "match": "\\b(lcm|mid|ckmin|ckmax|prefix|binarySearch|dijkstra|sum|lowerBound|upperBound|modpow|bfs)(?=\\s*\\()" }
      ]
    },
    "function-call": {
      "patterns": [
        { "name": "entity.name.function.zenpp", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.zenpp", "match": "\\*\\*|<<|>>|==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!&|^~?:]" }
      ]
    }
  }
}
